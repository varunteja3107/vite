import React, { useState, useEffect, useRef } from 'react';
import { Car, Trophy } from 'lucide-react';

export default function CarGame() {
  const [carPosition, setCarPosition] = useState(50);
  const [obstacles, setObstacles] = useState([]);
  const [score, setScore] = useState(0);
  const [gameOver, setGameOver] = useState(false);
  const [gameStarted, setGameStarted] = useState(false);
  const gameLoopRef = useRef();
  const obstacleTimerRef = useRef();

  const lanes = [25, 50, 75];

  useEffect(() => {
    const handleKeyPress = (e) => {
      if (!gameStarted || gameOver) return;
      
      if (e.key === 'ArrowLeft') {
        setCarPosition(prev => {
          const currentIndex = lanes.indexOf(prev);
          return currentIndex > 0 ? lanes[currentIndex - 1] : prev;
        });
      } else if (e.key === 'ArrowRight') {
        setCarPosition(prev => {
          const currentIndex = lanes.indexOf(prev);
          return currentIndex < lanes.length - 1 ? lanes[currentIndex + 1] : prev;
        });
      }
    };

    window.addEventListener('keydown', handleKeyPress);
    return () => window.removeEventListener('keydown', handleKeyPress);
  }, [gameStarted, gameOver]);

  useEffect(() => {
    if (!gameStarted || gameOver) return;

    gameLoopRef.current = setInterval(() => {
      setObstacles(prev => {
        const updated = prev
          .map(obs => ({ ...obs, y: obs.y + 5 }))
          .filter(obs => obs.y < 100);

        updated.forEach(obs => {
          if (obs.y > 75 && obs.y < 85 && Math.abs(obs.x - carPosition) < 8) {
            setGameOver(true);
          }
          if (obs.y === 100) {
            setScore(s => s + 10);
          }
        });

        return updated;
      });
    }, 50);

    obstacleTimerRef.current = setInterval(() => {
      const randomLane = lanes[Math.floor(Math.random() * lanes.length)];
      setObstacles(prev => [...prev, { x: randomLane, y: 0, id: Date.now() }]);
    }, 1500);

    return () => {
      clearInterval(gameLoopRef.current);
      clearInterval(obstacleTimerRef.current);
    };
  }, [gameStarted, gameOver, carPosition]);

  const startGame = () => {
    setGameStarted(true);
    setGameOver(false);
    setScore(0);
    setObstacles([]);
    setCarPosition(50);
  };

  const resetGame = () => {
    setGameStarted(false);
    setGameOver(false);
    setScore(0);
    setObstacles([]);
    setCarPosition(50);
  };

  return (
    <div className="flex flex-col items-center justify-center min-h-screen bg-gradient-to-b from-gray-800 to-gray-900 p-4">
      <div className="mb-4 text-center">
        <h1 className="text-4xl font-bold text-white mb-2">Highway Racer</h1>
        <div className="flex items-center justify-center gap-2 text-yellow-400 text-2xl">
          <Trophy size={28} />
          <span className="font-bold">{score}</span>
        </div>
      </div>

      <div className="relative w-80 h-96 bg-gray-700 rounded-lg overflow-hidden border-4 border-gray-600 shadow-2xl">
        {/* Road markings */}
        <div className="absolute left-1/3 top-0 w-0.5 h-full bg-white opacity-30"></div>
        <div className="absolute left-2/3 top-0 w-0.5 h-full bg-white opacity-30"></div>

        {/* Player car */}
        {gameStarted && (
          <div 
            className="absolute transition-all duration-200 text-blue-500"
            style={{ 
              left: `${carPosition}%`, 
              top: '80%',
              transform: 'translate(-50%, -50%)'
            }}
          >
            <Car size={40} />
          </div>
        )}

        {/* Obstacles */}
        {obstacles.map(obs => (
          <div
            key={obs.id}
            className="absolute text-red-500"
            style={{
              left: `${obs.x}%`,
              top: `${obs.y}%`,
              transform: 'translate(-50%, -50%)'
            }}
          >
            <Car size={40} />
          </div>
        ))}

        {/* Start screen */}
        {!gameStarted && !gameOver && (
          <div className="absolute inset-0 flex flex-col items-center justify-center bg-black bg-opacity-70">
            <p className="text-white text-lg mb-4 text-center px-4">
              Use ← → arrow keys to move
            </p>
            <button
              onClick={startGame}
              className="px-6 py-3 bg-green-600 text-white rounded-lg font-bold hover:bg-green-700 transition-colors"
            >
              Start Game
            </button>
          </div>
        )}

        {/* Game over screen */}
        {gameOver && (
          <div className="absolute inset-0 flex flex-col items-center justify-center bg-black bg-opacity-80">
            <h2 className="text-red-500 text-3xl font-bold mb-2">Game Over!</h2>
            <p className="text-white text-xl mb-4">Score: {score}</p>
            <button
              onClick={resetGame}
              className="px-6 py-3 bg-blue-600 text-white rounded-lg font-bold hover:bg-blue-700 transition-colors"
            >
              Play Again
            </button>
          </div>
        )}
      </div>

      <p className="mt-4 text-gray-400 text-sm">Dodge the red cars and rack up points!</p>
    </div>
  );
}
